{
  "name": "aegis-vault",
  "version": "1.1.1",
  "description": "Gestor local de contraseñas para Windows con bóveda cifrada y respaldos",
  "main": "electron/main.cjs",
  "author": "Aegis Security",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-distribution.mjs",
    "electron:dev": "vite build && electron .",
    "electron:start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:distribution": "node scripts/verify-distribution.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.aegis.vault",
    "productName": "Aegis Vault",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.ico",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aegis Vault",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Aegis-Vault-Setup-${version}.${ext}"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
